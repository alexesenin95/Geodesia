# Порт сервера
PORT=3000

# Секрет для подписи JWT-токенов — ОБЯЗАТЕЛЬНО смените в продакшене
JWT_SECRET=change-me-to-a-long-random-string

# Доступ в админку
ADMIN_USER=admin
# Пароль в открытом виде (для простоты). Захэшируется при старте.
ADMIN_PASSWORD=vyaz
# Либо задайте готовый bcrypt-хэш вместо ADMIN_PASSWORD:
# ADMIN_PASSWORD_HASH=$2a$10$....
